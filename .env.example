# Copy to .env and adjust. Every application setting is prefixed with AIC_.

# Django
AIC_SECRET_KEY=change-me
AIC_DEBUG_MODE=False
AIC_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when served behind a proxy/other origin, e.g. https://aic.example.com
AIC_CSRF_TRUSTED_ORIGINS=http://localhost:8000
AIC_WEB_PORT=8000

# Key for encrypting secrets stored in the database (AAP tokens etc). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required when AIC_DEBUG_MODE=False. Losing it makes stored secrets unreadable.
AIC_ENCRYPTION_KEY=

# PostgreSQL (host is set to the compose service name by compose.yml)
AIC_DB_NAME=ansibleinfracd
AIC_DB_USERNAME=ansibleinfracd
AIC_DB_PASSWORD=change-me
AIC_DB_PORT=5432

# Redis (cache on DB 1, Celery broker on DB 0)
AIC_REDIS_PORT=6379
